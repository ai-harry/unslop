# Server-side Anthropic key (used when the user does not supply their own BYOK key).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Only needed to (re)build the scraped corpus via `npm run build-corpus`.
# Get one at https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_...
