{
  "name": "unslop-desktop",
  "version": "0.1.0",
  "description": "Unslop menu-bar app: transform selected text in any app with a global hotkey.",
  "private": true,
  "author": "Unslop",
  "main": "./out/main/index.js",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "electron-vite dev",
    "build": "npm run icons && electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
